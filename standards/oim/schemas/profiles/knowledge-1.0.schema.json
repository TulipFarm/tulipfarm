            "maxLength": 128,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "maxLength": 1024,
            "type": "string"
          },
          "discoverOperationId": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 96,
            "type": "string"
          },
          "discoverItemsPointer": {
            "pattern": "^(?:$|/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*)$",
            "maxLength": 512,
            "type": "string"
          },
          "discoverMapping": {
            "additionalProperties": false,
