        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": ["mode", "operationId", "scopeParameter", "entriesPointer", "entry"],
          "properties": {
            "mode": {
              "const": "scope",
              "type": "string"
            },
            "operationId": {
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
