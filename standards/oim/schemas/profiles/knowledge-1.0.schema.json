{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oim:schema:1.0:profiles:knowledge-1.0.schema.json",
  "title": "Open Integration Manifest Knowledge 1.0",
  "additionalProperties": false,
