                  "pattern": "^(?:$|/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*)$",
                  "maxLength": 512,
                  "type": "string"
                },
                "kindValues": {
                  "additionalProperties": false,
                  "type": "object",
                  "properties": {
                    "user": {
                      "uniqueItems": true,
                      "type": "array",
                      "items": {
                        "maxLength": 128,
                        "type": "string"
                      }
                    },
                    "group": {
                      "uniqueItems": true,
                      "type": "array",
                      "items": {
                        "maxLength": 128,
                        "type": "string"
                      }
                    },
                    "domain": {
                      "uniqueItems": true,
                      "type": "array",
                      "items": {
                        "maxLength": 128,
                        "type": "string"
                      }
                    },
                    "public": {
                      "uniqueItems": true,
                      "type": "array",
                      "items": {
                        "maxLength": 128,
                        "type": "string"
                      }
                    }
                  }
                },
                "defaultKind": {
                  "type": "string",
                  "enum": ["user", "group", "domain", "public"]
                },
                "providerUserId": {
                  "pattern": "^(?:$|/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*)$",
                  "maxLength": 512,
                  "type": "string"
                },
                "providerGroupId": {
                  "pattern": "^(?:$|/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*)$",
                  "maxLength": 512,
                  "type": "string"
                },
                "domain": {
                  "pattern": "^(?:$|/(?:[^/~]|~[01])*(?:/(?:[^/~]|~[01])*)*)$",
                  "maxLength": 512,
                  "type": "string"
                }
              }
            }
          }
        }
