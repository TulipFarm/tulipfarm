              "id": {
                "pattern": "^[a-z][a-z0-9_]{1,63}$",
                "maxLength": 64,
                "type": "string"
              },
              "title": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "description": {
                "minLength": 1,
                "maxLength": 2048,
                "type": "string"
              },
              "type": {
