{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oim:schema:1.0:profiles:auth-1.0.schema.json",
  "title": "Open Integration Manifest Auth 1.0",
  "additionalProperties": false,
  "type": "object",
  "required": ["credentialSlots", "steps"],
  "properties": {
    "credentialSlots": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "label", "kind"],
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "maxLength": 64,
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "api_key",
              "bearer_token",
              "oauth2_access_token",
              "oauth2_refresh_token",
              "client_secret",
              "private_key",
              "webhook_secret"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "configurationFields": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "label", "type"],
        "properties": {
