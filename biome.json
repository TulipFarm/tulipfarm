{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      "**/node_modules",
      "**/dist",
      "**/build",
      "**/.next",
      "**/out",
      "**/.source",
      "**/next-env.d.ts",
      "**/.turbo",
      "**/.agent",
      "**/.agents",
      "**/.claude"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "organizeImports": {
    "enabled": true
  },
  "overrides": [
    {
      "include": [".agent/**", ".agents/**", ".claude/**"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false },
      "organizeImports": { "enabled": false }
    }
  ]
}
