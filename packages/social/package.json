    },
    "./posts": {
      "types": "./dist/posts.d.ts",
      "default": "./dist/posts.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "node --test test/*.integration.mjs"
  },
  "dependencies": {
    "@tulipfarm/access": "workspace:*",
    "@tulipfarm/atlassian": "workspace:*",
    "@tulipfarm/extensions": "workspace:*",
    "@tulipfarm/files": "workspace:*",
