{
  "name": "@tulipfarm/social",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./variant-states": {
      "types": "./dist/variant-states.d.ts",
      "default": "./dist/variant-states.js"
    },
    "./x-text": {
      "types": "./dist/x-text.d.ts",
      "default": "./dist/x-text.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./batch-digest": {
      "types": "./dist/batch-digest.d.ts",
      "default": "./dist/batch-digest.js"
    },
    "./platform-fetch": {
      "types": "./dist/platform-fetch.d.ts",
      "default": "./dist/platform-fetch.js"
    },
    "./testing/fake": {
      "types": "./dist/platforms/fake.d.ts",
      "default": "./dist/platforms/fake.js"
    },
    "./platform-apps": {
      "types": "./dist/platform-apps.d.ts",
      "default": "./dist/platform-apps.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./accounts": {
      "types": "./dist/accounts.d.ts",
      "default": "./dist/accounts.js"
    },
    "./channels": {
      "types": "./dist/channels.d.ts",
      "default": "./dist/channels.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
