      }
    ],
    "checked": "2026-11-14"
  },
  "registryName": "com.polaranalytics/polar",
  "icons": {
    "color": "#3F51F5"
  },
  "supportedBy": ["chatgpt", "claude", "microsoft-copilot", "manus", "gumloop"]
