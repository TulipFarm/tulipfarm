{
  "$schema": "../schemas/app.v1.json",
  "id": "contentful",
  "name": "Contentful",
  "maker": "Contentful",
  "homepage": "https://www.contentful.com",
  "category": "docs-and-files",
  "teams": ["marketing", "engineering"],
  "summary": "Manage content entries in Contentful",
