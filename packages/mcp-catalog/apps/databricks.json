{
  "$schema": "../schemas/app.v1.json",
  "id": "databricks",
  "name": "Databricks",
  "maker": "Databricks",
  "homepage": "https://www.databricks.com",
  "category": "data-and-databases",
  "teams": ["engineering", "operations"],
  "summary": "Query Databricks data, Genie spaces, and functions",
  "capabilities": [
    "Run SQL on Databricks SQL warehouses",
    "Ask Genie spaces questions in plain language",
    "Call Unity Catalog functions as tools",
    "Search vector indexes"
  ],
  "official": {
    "evidence": "https://docs.databricks.com/aws/en/generative-ai/mcp/managed-mcp"
  },
  "docs": "https://docs.databricks.com/aws/en/generative-ai/mcp/managed-mcp",
  "remote": {
    "url": "https://{workspace-host}/api/2.0/mcp/sql",
    "transport": "streamable-http",
    "auth": "oauth",
    "variables": [
      {
        "name": "workspace-host",
        "description": "Your Databricks workspace host",
        "example": "dbc-1234.cloud.databricks.com"
      }
    ]
  },
  "icons": {
    "simpleIcons": "databricks",
    "color": "#FF3621"
  },
  "supportedBy": ["copilot-studio", "manus", "perplexity", "lindy", "gumloop", "relevance-ai", "dust", "glean"]
}
