  },
  "docs": "https://github.com/ScrapingBee/mcp-server",
  "remote": {
    "url": "https://mcp.scrapingbee.com/mcp",
    "transport": "streamable-http",
    "auth": "api-key",
    "headers": [
      {
        "name": "Authorization",
        "value": "Bearer {key}",
        "description": "ScrapingBee API key"
      }
    ],
    "checked": "2026-11-14"
  },
  "registryName": "com.scrapingbee/mcp",
  "icons": {
    "color": "#FFC942"
  },
  "supportedBy": ["lindy", "relevance-ai", "github-registry"]
