{
  "$schema": "../schemas/app.v1.json",
  "id": "scrapingbee",
  "name": "ScrapingBee",
  "maker": "ScrapingBee",
  "homepage": "https://www.scrapingbee.com",
  "category": "search-and-research",
  "teams": ["engineering", "marketing"],
  "summary": "Scrape web pages and search results with ScrapingBee",
  "capabilities": ["Scrape pages with JavaScript rendering", "Get Google search results", "Extract data with AI rules"],
  "official": {
    "evidence": "https://github.com/ScrapingBee/mcp-server",
