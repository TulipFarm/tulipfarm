{
  "$schema": "../schemas/app.v1.json",
  "id": "circleci",
  "name": "CircleCI",
  "maker": "CircleCI",
  "homepage": "https://circleci.com",
  "category": "code",
  "teams": ["engineering"],
  "summary": "Find and fix failing CircleCI builds",
  "capabilities": ["Read logs from failed builds", "Find flaky tests", "Check pipeline status and rerun workflows"],
  "official": {
    "evidence": "https://circleci.com/docs/guides/toolkit/using-the-circleci-mcp-server/",
    "repository": "https://github.com/CircleCI-Public/mcp-server-circleci"
  },
  "docs": "https://circleci.com/docs/guides/toolkit/using-the-circleci-mcp-server/",
  "remote": {
    "url": "https://mcp.circleci.com/v1/mcp",
    "transport": "streamable-http",
    "auth": "oauth",
    "checked": "2026-11-14"
  },
  "packages": [
    {
      "registry": "npm",
      "name": "@circleci/mcp-server-circleci",
      "env": [
        {
          "name": "CIRCLECI_TOKEN",
          "description": "CircleCI personal API token",
          "secret": true,
          "required": true
        }
      ]
    }
  ],
  "registryName": "com.circleci/mcp",
  "icons": {
    "simpleIcons": "circleci",
    "color": "#343434"
  },
  "supportedBy": ["claude", "lindy", "relevance-ai", "docker"]
}
