{
  "$id": "tulipfarm.ai/v1/Role",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "tulipfarm.ai/v1",
      "type": "string"
    },
    "kind": {
      "const": "Role",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "authoredVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "displayName": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "validated",
            "simulated",
            "approved",
            "published",
            "active",
            "retired"
          ],
          "type": "string"
        },
        "publishedDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "slug": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "schemaVersion",
        "authoredVersion",
        "lifecycle"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "grants": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "actions": {
                "items": {
                  "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "audiences": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "conditions": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "attribute": {
                      "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$",
                      "type": "string"
                    },
                    "operator": {
                      "anyOf": [
                        {
                          "const": "equals",
                          "type": "string"
                        },
                        {
                          "const": "notEquals",
                          "type": "string"
                        },
                        {
                          "const": "in",
                          "type": "string"
                        },
                        {
                          "const": "notIn",
                          "type": "string"
                        }
                      ]
                    },
                    "value": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array",
                          "uniqueItems": true
                        }
                      ]
                    }
                  },
                  "required": [
                    "attribute",
                    "operator",
                    "value"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "dataClasses": {
                "items": {
                  "pattern": "^[a-z][a-z0-9_]*(?:[-_][a-z0-9_]+)*$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "delegable": {
                "type": "boolean"
              },
              "destinations": {
                "items": {
                  "minLength": 1,
                  "pattern": "^(?!\\*$).+$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "domains": {
                "items": {
                  "pattern": "^(?:\\*|[a-z][a-z0-9_]*(?:[-_][a-z0-9_]+)*)$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "effect": {
                "anyOf": [
                  {
                    "const": "allow",
                    "type": "string"
                  },
                  {
                    "const": "deny",
                    "type": "string"
                  }
                ]
              },
              "expiresAt": {
                "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$",
                "type": "string"
              },
              "fields": {
                "items": {
                  "minLength": 1,
                  "pattern": "^(?!\\*$).+$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "resource": {
                "additionalProperties": false,
                "properties": {
                  "recordIds": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "types": {
                    "items": {
                      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z0-9_-]+)?$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  }
                },
                "required": [
                  "types"
                ],
                "type": "object"
              }
            },
            "required": [
              "effect",
              "actions",
              "resource",
              "delegable"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "inherits": {
          "items": {
            "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "principalTypes": {
          "items": {
            "enum": [
              "user",
              "agent",
              "routine",
              "integration_adapter",
              "api",
              "service"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "principalTypes",
        "grants"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
