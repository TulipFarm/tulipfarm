{
  "$id": "tulipfarm.ai/v1/IntegrationAdapter",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "tulipfarm.ai/v1",
      "type": "string"
    },
    "kind": {
      "const": "IntegrationAdapter",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "authoredVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "displayName": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "validated",
            "simulated",
            "approved",
            "published",
            "active",
            "retired"
          ],
          "type": "string"
        },
        "publishedDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "slug": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "schemaVersion",
        "authoredVersion",
        "lifecycle"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "authTypes": {
          "items": {
            "anyOf": [
              {
                "const": "none",
                "type": "string"
              },
              {
                "const": "oauth2",
                "type": "string"
              },
              {
                "const": "token",
                "type": "string"
              },
              {
                "const": "app",
                "type": "string"
              },
              {
                "const": "password",
                "type": "string"
              }
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "events": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "execution": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "adapter": {
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                  "type": "string"
                },
                "mode": {
                  "const": "managed",
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "adapter"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "endpoint": {
                  "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[1-9][0-9]{0,4})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$",
                  "type": "string"
                },
                "mode": {
                  "const": "externalProtocol",
                  "type": "string"
                },
                "protocolVersion": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "mode",
                "endpoint",
                "protocolVersion"
              ],
              "type": "object"
            }
          ]
        },
        "operations": {
          "items": {
            "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "provider": {
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "execution",
        "authTypes",
        "operations",
        "events"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
