{
  "$id": "tulipfarm.ai/v1/Resource",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "tulipfarm.ai/v1",
      "type": "string"
    },
    "kind": {
      "const": "Resource",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "authoredVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "displayName": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "validated",
            "simulated",
            "approved",
            "published",
            "active",
            "retired"
          ],
          "type": "string"
        },
        "publishedDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "slug": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "schemaVersion",
        "authoredVersion",
        "lifecycle"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "hooks": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object"
        },
        "recordSchema": {
          "additionalProperties": true,
          "properties": {
            "properties": {
              "additionalProperties": true,
              "properties": {},
              "type": "object"
            },
            "required": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "type": {
              "const": "object",
              "type": "string"
            }
          },
          "required": [
            "type",
            "properties"
          ],
          "type": "object"
        }
      },
      "required": [
        "recordSchema"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
