{
  "$id": "tulipfarm.ai/v1/MemorySettings",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "tulipfarm.ai/v1",
      "type": "string"
    },
    "kind": {
      "const": "MemorySettings",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "authoredVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "displayName": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "validated",
            "simulated",
            "approved",
            "published",
            "active",
            "retired"
          ],
          "type": "string"
        },
        "publishedDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "slug": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "schemaVersion",
        "authoredVersion",
        "lifecycle"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "defaultExpiryDays": {
          "maximum": 3650,
          "minimum": 1,
          "type": "integer"
        },
        "inferredDurableMemory": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "confirmationRequired": {
                  "const": true,
                  "type": "boolean"
                },
                "enabled": {
                  "const": true,
                  "type": "boolean"
                }
              },
              "required": [
                "enabled",
                "confirmationRequired"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "const": false,
                  "type": "boolean"
                }
              },
              "required": [
                "enabled"
              ],
              "type": "object"
            }
          ]
        },
        "scopes": {
          "items": {
            "enum": [
              "user_private",
              "user_agent",
              "agent_private",
              "team_role",
              "business",
              "run_local"
            ],
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "scopes",
        "inferredDurableMemory"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
