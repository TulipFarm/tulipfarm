{
  "$id": "tulipfarm.ai/v1/Form",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "tulipfarm.ai/v1",
      "type": "string"
    },
    "kind": {
      "const": "Form",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "authoredVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "displayName": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "type": "string"
        },
        "lifecycle": {
          "enum": [
            "draft",
            "validated",
            "simulated",
            "approved",
            "published",
            "active",
            "retired"
          ],
          "type": "string"
        },
        "publishedDigest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "slug": {
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "schemaVersion",
        "authoredVersion",
        "lifecycle"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "additionalProperties": false,
          "properties": {
            "roleIds": {
              "items": {
                "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "roleIds"
          ],
          "type": "object"
        },
        "expiresInSeconds": {
          "maximum": 604800,
          "minimum": 1,
          "type": "integer"
        },
        "fields": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "input": {
                "anyOf": [
                  {
                    "const": "text",
                    "type": "string"
                  },
                  {
                    "const": "email",
                    "type": "string"
                  },
                  {
                    "const": "number",
                    "type": "string"
                  },
                  {
                    "const": "textarea",
                    "type": "string"
                  },
                  {
                    "const": "select",
                    "type": "string"
                  },
                  {
                    "const": "radio",
                    "type": "string"
                  },
                  {
                    "const": "checkbox",
                    "type": "string"
                  },
                  {
                    "const": "switch",
                    "type": "string"
                  },
                  {
                    "const": "date",
                    "type": "string"
                  }
                ]
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "name": {
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "type": "string"
              },
              "options": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "required": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "label",
              "input"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "submission": {
          "additionalProperties": false,
          "properties": {
            "inputName": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
              "type": "string"
            },
            "triggerId": {
              "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9A-HJKMNP-TV-Z]{26})$",
              "type": "string"
            }
          },
          "required": [
            "triggerId",
            "inputName"
          ],
          "type": "object"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "submission",
        "audience",
        "fields"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
