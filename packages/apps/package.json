{
  "name": "@tulipfarm/apps",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host-header-publisher": {
      "types": "./dist/host-header-publisher.d.ts",
      "default": "./dist/host-header-publisher.js"
    },
    "./sites": {
      "types": "./dist/sites.d.ts",
      "default": "./dist/sites.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "default": "./dist/store/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@tulipfarm/extensions": "workspace:*",
    "pg": "8.23.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tulipfarm/typescript-config": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1"
  }
}
