{
  "name": "@tulipfarm/slack",
  "private": true,
  "type": "module",
  "exports": {
    "./action-contracts": {
      "types": "./dist/action-contracts.d.ts",
      "default": "./dist/action-contracts.js"
    },
    "./corpus": {
      "types": "./dist/corpus-provider.d.ts",
      "default": "./dist/corpus-provider.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@tulipfarm/integrations": "workspace:*",
    "@tulipfarm/conversations": "workspace:*",
    "@tulipfarm/access": "workspace:*",
    "@tulipfarm/knowledge": "workspace:*",
    "@tulipfarm/observability": "workspace:*",
    "@tulipfarm/slack-presentation": "workspace:*",
    "@tulipfarm/workspace-storage": "workspace:*",
    "pg": "8.23.0",
    "jose": "6.2.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tulipfarm/extensions": "workspace:*",
    "@tulipfarm/typescript-config": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1"
  }
}
