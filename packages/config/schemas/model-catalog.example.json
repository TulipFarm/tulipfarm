{
  "$schema": "https://tulipfarm.ai/schemas/model-catalog.v1.json",
  "version": 1,
  "providers": {
    "foundry": { "type": "azure", "apiKeyEnv": "FOUNDRY_API_KEY", "endpointEnv": "FOUNDRY_ENDPOINT" },
    "gateway": { "type": "openai-compatible", "apiKeyEnv": "GATEWAY_API_KEY", "endpointEnv": "GATEWAY_BASE_URL" }
  },
  "models": [
    {
      "id": "grok",
      "name": "Grok",
      "vendor": "xai",
      "routes": [
        { "provider": "foundry", "model": "grok-4.6" },
        { "provider": "xai", "model": "grok-4.6" }
      ],
      "default": true,
      "roles": ["review", "plan"],
      "limits": { "maxInputTokens": 200000, "maxOutputTokens": 128000 },
      "pricing": [
        { "usdPerMillionTokens": { "input": 2, "output": 6, "cacheRead": 0.5 } },
        { "promptTokensAbove": 200000, "usdPerMillionTokens": { "input": 4, "output": 12, "cacheRead": 1 } }
      ]
    },
    {
      "id": "claude-haiku",
      "name": "Claude Haiku",
      "vendor": "anthropic",
      "routes": [{ "provider": "anthropic", "model": "claude-haiku-4-5" }],
      "selectable": false,
      "roles": ["title", "compaction", "heartbeat"],
      "limits": { "maxInputTokens": 200000, "maxOutputTokens": 64000 },
      "capabilities": { "responseModelAliases": ["claude-haiku-4-5-20251001"] },
      "pricing": [
        {
          "usdPerMillionTokens": { "input": 1, "output": 5, "cacheRead": 0.1, "cacheWrite5m": 1.25, "cacheWrite1h": 2 }
        }
      ]
    },
    {
      "id": "gpt-sol",
      "name": "GPT Sol",
      "vendor": "openai",
      "routes": [{ "provider": "foundry", "model": "gpt-6-sol" }],
      "paused": true,
      "limits": { "maxInputTokens": 922000, "maxOutputTokens": 128000 },
      "capabilities": { "reasoningOffForTools": true },
      "pricing": [
        { "usdPerMillionTokens": { "input": 2, "output": 10, "cacheRead": 0.2, "cacheWrite": 2.5 } },
        {
          "promptTokensAbove": 272000,
          "usdPerMillionTokens": { "input": 4, "output": 15, "cacheRead": 0.4, "cacheWrite": 5 }
        }
      ]
    },
    {
      "id": "local-llama",
      "name": "Local Llama",
      "vendor": "meta",
      "routes": [{ "provider": "gateway", "model": "llama-4-70b" }],
      "limits": { "maxInputTokens": 128000, "maxOutputTokens": 8192 },
      "pricing": "unmetered"
    }
  ]
}
