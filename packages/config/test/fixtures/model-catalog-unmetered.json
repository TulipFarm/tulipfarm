{
  "$schema": "https://tulipfarm.ai/schemas/model-catalog.v1.json",
  "version": 1,
  "models": [
    {
      "id": "local-chat",
      "name": "Local Chat",
      "vendor": "local",
      "routes": [
        {
          "provider": "azure",
          "model": "Local-Chat-1"
        }
      ],
      "default": true,
      "limits": {
        "maxInputTokens": 128000,
        "maxOutputTokens": 16000
      },
      "pricing": "unmetered"
    },
    {
      "id": "metered-chat",
      "name": "Metered Chat",
      "vendor": "local",
      "routes": [
        {
          "provider": "azure",
          "model": "Metered-Chat-1"
        }
      ],
      "limits": {
        "maxInputTokens": 128000,
        "maxOutputTokens": 16000
      },
      "pricing": [
        {
          "usdPerMillionTokens": {
            "input": 0.5,
            "output": 1.5
          }
        }
      ]
    }
  ]
}
