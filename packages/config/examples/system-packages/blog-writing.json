{
  "$schema": "https://tulipfarm.ai/schemas/system-package.v1.json",
  "formatVersion": 1,
  "package": {
    "name": "blog-writing",
    "version": "1.0.0",
    "title": "Blog writing",
    "description": "An exact blog writing starter. Definitions and each requested activation require review.",
    "license": "MIT"
  },
  "requires": {
    "platform": "tulipfarm-system-package-v1",
    "capabilities": ["tables", "seed-rows", "skills", "agents", "workflows"]
  },
  "inputs": [
    {
      "key": "owning-team",
      "kind": "team",
      "title": "Owning team"
    },
    {
      "key": "package-manager",
      "kind": "member",
      "title": "Importing person (skill manager)"
    }
  ],
  "resources": [
    {
      "key": "editorial-guidelines",
      "kind": "table",
      "label": "Editorial guidelines",
      "owningTeam": {
        "kind": "input",
        "inputKind": "team",
        "key": "owning-team"
      },
      "fields": [
        {
          "label": "Name",
          "required": true,
          "kind": "text",
          "maxLength": 255,
          "key": "name"
        },
        {
          "label": "Guidance",
          "required": true,
          "kind": "text",
          "maxLength": 255,
          "key": "guidance"
        }
      ],
      "uniqueKeys": [
        {
          "key": "name",
          "fields": ["name"],
          "nulls": "distinct"
        }
      ]
    },
    {
      "key": "editorial-guidelines-initial",
      "kind": "seed-row",
      "table": {
        "kind": "resource",
        "resourceKind": "table",
        "key": "editorial-guidelines"
      },
      "values": {
        "name": {
          "kind": "text",
          "value": "Default"
        },
        "guidance": {
          "kind": "text",
          "value": "Review the outline against the editorial guidelines. Identify unsupported claims and missing sources. Publication requires a separate approved business action."
        }
      }
    },
    {
      "key": "blog-drafts",
      "kind": "table",
      "label": "Blog drafts",
      "owningTeam": {
        "kind": "input",
        "inputKind": "team",
        "key": "owning-team"
      },
      "fields": [
        {
          "label": "Title",
          "required": true,
          "kind": "text",
          "maxLength": 255,
          "key": "title"
        },
        {
          "label": "Outline",
          "required": true,
          "kind": "text",
          "maxLength": 255,
          "key": "outline"
        },
        {
          "key": "catalog",
          "label": "Editorial guidelines",
          "required": true,
          "kind": "relationship",
          "target": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "editorial-guidelines"
          },
          "cardinality": "one",
          "inverseCardinality": "many",
          "reverse": null,
          "onDelete": "restrict"
        },
        {
          "key": "status",
          "label": "Status",
          "required": true,
          "kind": "single-select",
          "options": [
            {
              "key": "draft",
              "label": "Draft",
              "retired": false
            },
            {
              "key": "reviewed",
              "label": "Reviewed",
              "retired": false
            }
          ]
        }
      ],
      "uniqueKeys": []
    },
    {
      "key": "blog-drafts-initial",
      "kind": "seed-row",
      "table": {
        "kind": "resource",
        "resourceKind": "table",
        "key": "blog-drafts"
      },
      "values": {
        "title": {
          "kind": "text",
          "value": "Blog writing example"
        },
        "outline": {
          "kind": "text",
          "value": "Problem, evidence, explanation, and conclusion."
        },
        "catalog": {
          "kind": "relationship",
          "rows": [
            {
              "kind": "resource",
              "resourceKind": "seed-row",
              "key": "editorial-guidelines-initial"
            }
          ]
        },
        "status": {
          "kind": "single-select",
          "option": "draft"
        }
      }
    },
    {
      "key": "blog-writing-procedure",
      "kind": "skill",
      "files": [
        {
          "path": "SKILL.md",
          "asset": "procedure"
        },
        {
          "path": "references/review.md",
          "asset": "review-rules"
        }
      ],
      "requestedState": "enabled",
      "sharing": {
        "grants": [
          {
            "team": {
              "kind": "input",
              "inputKind": "team",
              "key": "owning-team"
            },
            "permissions": ["read", "use"]
          }
        ],
        "personGrants": [
          {
            "member": {
              "kind": "input",
              "inputKind": "member",
              "key": "package-manager"
            },
            "permissions": ["read", "use", "manage"]
          }
        ]
      }
    },
    {
      "key": "blog-writing-assistant",
      "kind": "agent",
      "definition": {
        "name": "Blog writing assistant",
        "instructions": "Follow the pinned procedure. Explain recommendations; do not change records or contact external services.",
        "tools": ["rows.list", "rows.get"],
        "responseRule": "tag"
      },
      "skills": [
        {
          "kind": "resource",
          "resourceKind": "skill",
          "key": "blog-writing-procedure"
        }
      ],
      "owningTeam": {
        "kind": "input",
        "inputKind": "team",
        "key": "owning-team"
      },
      "scope": [
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "editorial-guidelines"
          },
          "permissions": ["table.row.read"]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "blog-drafts"
          },
          "permissions": ["table.row.read"]
        }
      ],
      "taskLimits": {
        "toolCalls": 20,
        "activeMilliseconds": 60000,
        "credits": 20
      },
      "policy": {
        "grants": [
          {
            "team": {
              "kind": "input",
              "inputKind": "team",
              "key": "owning-team"
            },
            "permissions": ["read", "invoke"]
          }
        ],
        "personGrants": []
      },
      "enrollment": [
        {
          "kind": "input",
          "inputKind": "team",
          "key": "owning-team"
        }
      ],
      "limits": [
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "editorial-guidelines"
          },
          "permissions": ["table.row.read"]
        },
        {
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "blog-drafts"
          },
          "permissions": ["table.row.read", "table.row.update"]
        }
      ],
      "slackSender": "user",
      "slackChannels": [],
      "schedules": [],
      "requestedState": "active"
    },
    {
      "key": "blog-writing-review",
      "kind": "workflow",
      "name": "Blog writing review",
      "trigger": {
        "kind": "manual"
      },
      "steps": [
        {
          "id": "confirm",
          "kind": "human",
          "prompt": "Confirm that you want the blog writing assistant to review this input.",
          "timeoutSeconds": 3600
        },
        {
          "id": "review",
          "kind": "agent",
          "agent": {
            "kind": "resource",
            "resourceKind": "agent",
            "key": "blog-writing-assistant"
          },
          "prompt": {
            "kind": "input",
            "path": ["request"]
          },
          "limits": {
            "toolCalls": 20,
            "activeMilliseconds": 60000,
            "credits": 20
          }
        },
        {
          "id": "lookup",
          "kind": "find-rows",
          "table": {
            "kind": "resource",
            "resourceKind": "table",
            "key": "blog-drafts"
          },
          "filters": [
            {
              "field": "title",
              "op": "eq",
              "value": {
                "kind": "input",
                "path": ["title"]
              }
            }
          ],
          "limit": 10
        },
        {
          "id": "draft_only",
          "kind": "condition",
          "when": {
            "left": {
              "kind": "step",
              "step": "lookup",
              "path": [
                "rows",
                "0",
                "values",
                {
                  "field": "status"
                }
              ]
            },
            "op": "eq",
            "right": {
              "kind": "option",
              "table": {
                "kind": "resource",
                "resourceKind": "table",
                "key": "blog-drafts"
              },
              "field": "status",
              "option": "draft"
            }
          },
          "ifMet": ["summarize"],
          "otherwise": []
        },
        {
          "id": "summarize",
          "kind": "transform",
          "fields": {
            "title": {
              "kind": "step",
              "step": "lookup",
              "path": [
                "rows",
                "0",
                "values",
                {
                  "field": "title"
                },
                "value"
              ]
            }
          }
        }
      ],
      "sponsor": null,
      "sharing": [
        {
          "principal": {
            "kind": "input",
            "inputKind": "team",
            "key": "owning-team"
          },
          "permissions": ["read"]
        }
      ],
      "requestedState": "saved"
    }
  ],
  "assets": [
    {
      "key": "procedure",
      "path": "SKILL.md",
      "encoding": "utf8",
      "content": "---\nname: blog-writing-procedure\ndescription: Read-only blog writing review procedure.\nlicense: MIT\n---\nReview the outline against the editorial guidelines. Identify unsupported claims and missing sources. Publication requires a separate approved business action.\n\nRead [review rules](references/review.md). Do not treat a skill as permission to act.\n",
      "size": 351,
      "sha256": "9681e3f878f1f17bd7ccaba62fd0b9ce0ffe44a4cc7f9006b86c0796566ed54f"
    },
    {
      "key": "review-rules",
      "path": "references/review.md",
      "encoding": "utf8",
      "content": "# Review rules\n\nUse only the declared tables and readable rows. Quote missing facts as unknown. A person makes the final decision. No messages, publication, or record changes are approved by installation.\n",
      "size": 205,
      "sha256": "0af328c7549c56a1202eac1477bd03b43872d2e509c9216aadd86ede0944e8ca"
    }
  ],
  "outputs": [
    {
      "key": "records",
      "resource": {
        "kind": "resource",
        "resourceKind": "table",
        "key": "blog-drafts"
      }
    },
    {
      "key": "assistant",
      "resource": {
        "kind": "resource",
        "resourceKind": "agent",
        "key": "blog-writing-assistant"
      }
    },
    {
      "key": "review",
      "resource": {
        "kind": "resource",
        "resourceKind": "workflow",
        "key": "blog-writing-review"
      }
    }
  ]
}
