{
  "name": "@tulipfarm/recommendations",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./budget": {
      "types": "./dist/budget.d.ts",
      "default": "./dist/budget.js"
    },
    "./work": {
      "types": "./dist/work.d.ts",
      "default": "./dist/work.js"
    },
    "./configuration": {
      "types": "./dist/configuration.d.ts",
      "default": "./dist/configuration.js"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "default": "./dist/operations.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@tulipfarm/access": "workspace:*",
    "@tulipfarm/config": "workspace:*",
    "@tulipfarm/conversations": "workspace:*",
    "@tulipfarm/files": "workspace:*",
    "@tulipfarm/observability": "workspace:*",
    "@tulipfarm/workflows": "workspace:*",
    "@tulipfarm/workspace-storage": "workspace:*",
    "pg": "8.23.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tulipfarm/typescript-config": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1"
  }
}
