{
  "id": "support-loads-only-an-advertised-skill-reference",
  "tier": "l2",
  "agent": "support",
  "input": [
    {
      "role": "user",
      "content": "Load the data-analyst Skill, then read the first reference it advertises before answering."
    }
  ],
  "platformTools": ["skill"],
  "toolResults": [
    {
      "name": "skill",
      "output": {
        "name": "data-analyst",
        "frontmatter": { "description": "Analyze business data." },
        "body": "Read one advertised reference before answering.",
        "files": ["references/canonical-examples.md"]
      }
    },
    {
      "name": "skill",
      "output": {
        "name": "data-analyst",
        "file": "references/canonical-examples.md",
        "content": "Canonical analysis starts by checking the source and date range."
      }
    }
  ],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [{ "callId": "load", "name": "skill", "arguments": { "name": "data-analyst" } }]
    },
    {
      "kind": "tool_calls",
      "calls": [
        {
          "callId": "file",
          "name": "skill",
          "arguments": { "name": "data-analyst", "file": "references/canonical-examples.md" }
        }
      ]
    },
    {
      "kind": "text",
      "text": "I loaded the Skill and checked its canonical example. Start by checking the source and date range."
    }
  ],
  "expect": [
    { "kind": "tool_call_order", "names": ["skill", "skill"] },
    {
      "kind": "tool_argument_equals",
      "name": "skill",
      "path": "file",
      "value": "references/canonical-examples.md"
    },
    { "kind": "tool_call_count", "count": 2 },
    { "kind": "output_contains", "text": "source and date range" },
    { "kind": "loop_status", "status": "completed" }
  ]
}
