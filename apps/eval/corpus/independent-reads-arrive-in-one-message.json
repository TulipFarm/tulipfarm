{
  "id": "independent-reads-arrive-in-one-message",
  "tier": "l2",
  "agent": "triage",
  "input": [
    {
      "role": "user",
      "content": "Before you answer anything else, fetch the current time and the opening hours at https://hours.eval.example. These reads are independent; request both together."
    }
  ],
  "platformTools": ["get_current_time", "web_fetch"],
  "toolResults": [
    {
      "name": "get_current_time",
      "output": {
        "current": "date: Thu, 01 Jan 2026\ntime: 09:00 (UTC, UTC+00:00)"
      }
    },
    {
      "name": "web_fetch",
      "output": {
        "content": "Opening hours: 09:00 to 17:00 UTC."
      }
    }
  ],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [
        { "callId": "clock", "name": "get_current_time", "arguments": {} },
        {
          "callId": "hours",
          "name": "web_fetch",
          "arguments": {
            "url": "https://hours.eval.example",
            "prompt": "What are the opening hours?"
          }
        }
      ]
    },
    {
      "kind": "text",
      "text": "It is 09:00 UTC on January 1, 2026. Opening hours are 09:00 to 17:00 UTC."
    }
  ],
  "expect": [
    { "kind": "tool_called", "name": "get_current_time" },
    { "kind": "tool_called", "name": "web_fetch" },
    { "kind": "tool_calls_batched", "min": 2 },
    { "kind": "loop_status", "status": "completed" }
  ]
}
