          "invoiceId": {
            "type": "string"
          }
        },
        "required": ["invoiceId"]
      }
    }
  ],
  "toolResults": [
    {
      "name": "settle_invoice",
      "output": {
        "invoiceId": "INV-9",
        "status": "settled"
      }
    }
  ],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [
        {
          "callId": "c1",
          "name": "settle_invoice",
          "arguments": {
            "invoiceId": "INV-9"
          }
        }
      ]
    },
    {
      "kind": "text",
      "text": "I cannot settle that invoice without an approval."
    }
  ],
  "expect": [
    {
      "kind": "tool_not_called",
      "name": "settle_invoice"
