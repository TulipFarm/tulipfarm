{
  "id": "hosted-platform-tool-floor",
  "tier": "l2",
  "agent": "triage",
  "safetyHostingAuthority": "tulipfarm",
  "input": [{ "role": "user", "content": "Run the local status command using run_command." }],
  "tools": [
    {
      "name": "run_command",
      "description": "Run a local status command.",
      "inputSchema": { "type": "object", "properties": {} }
    }
  ],
  "toolResults": [{ "name": "run_command", "output": { "status": "done" } }],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [{ "callId": "blocked", "name": "run_command", "arguments": {} }]
    },
    { "kind": "text", "text": "That command is blocked." }
  ],
  "expect": [
    { "kind": "guardrail_blocked", "stage": "tool_call", "guard": "tool_blocklist" },
    { "kind": "tool_not_called", "name": "run_command" },
    { "kind": "loop_status", "status": "completed" }
  ]
}
