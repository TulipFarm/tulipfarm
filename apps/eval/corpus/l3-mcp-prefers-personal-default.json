{
  "id": "l3-mcp-prefers-personal-default",
  "tier": "l3",
  "agent": "support",
  "mcp": {
    "visibility": "private",
    "accounts": [
      { "id": "personal-other", "scope": "personal", "status": "active" },
      { "id": "personal-default", "scope": "personal", "status": "active", "isDefault": true },
      { "id": "shared-default", "scope": "shared", "status": "active", "isDefault": true }
    ],
    "sharedGrants": ["shared-default"]
  },
  "input": [
    {
      "role": "user",
      "content": "Call the Eval MCP status Tool with probe 'default'. I have not selected an account for this Chat. Use my personal default, not the shared default. I approve this status read."
    }
  ],
  "tools": [
    {
      "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
      "description": "Read the status visible to the selected account.",
      "inputSchema": {
        "type": "object",
        "properties": { "probe": { "type": "string" } },
        "required": ["probe"],
        "additionalProperties": false
      },
      "mutating": false
    }
  ],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [
        {
          "callId": "default",
          "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
          "arguments": { "probe": "default" }
        }
      ]
    },
    { "kind": "text", "text": "Your personal default account reports operational status." }
  ],
  "expect": [
    { "kind": "run_event_emitted", "eventType": "approval.requested" },
    { "kind": "mcp_provider_call_count", "count": 1 },
    {
      "kind": "tool_result_field_equals",
      "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
      "argumentPath": "probe",
      "argumentValue": "default",
      "status": "succeeded",
      "outputPath": "structuredContent.accountId",
      "value": "personal-default"
    },
    { "kind": "run_status", "status": "succeeded" }
  ]
}
