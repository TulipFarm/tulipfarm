{
  "id": "l3-mcp-every-approval-is-visible",
  "tier": "l3",
  "agent": "support",
  "mcp": {
    "visibility": "private",
    "accounts": [{ "id": "personal", "scope": "personal", "status": "active", "isDefault": true }]
  },
  "input": [
    {
      "role": "user",
      "content": "Use my personal account to call the Eval MCP status Tool with probe 'first'. After that call succeeds, call it again with probe 'second'. Request approval for each call. Then report the two results. Do not batch the calls."
    }
  ],
  "tools": [
    {
      "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
      "description": "Read the status visible to the selected account.",
      "inputSchema": {
        "type": "object",
        "properties": { "probe": { "type": "string" } },
        "required": ["probe"],
        "additionalProperties": false
      },
      "mutating": false
    }
  ],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [
        {
          "callId": "first",
          "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
          "arguments": { "probe": "first" }
        }
      ]
    },
    {
      "kind": "tool_calls",
      "calls": [
        {
          "callId": "second",
          "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
          "arguments": { "probe": "second" }
        }
      ]
    },
    { "kind": "text", "text": "Both status reads completed." }
  ],
  "expect": [
    { "kind": "run_event_emitted", "eventType": "approval.requested", "count": 2 },
    { "kind": "mcp_provider_call_count", "count": 2 },
    {
      "kind": "tool_result_field_equals",
      "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
      "argumentPath": "probe",
      "argumentValue": "first",
      "status": "succeeded",
      "outputPath": "structuredContent.accountId",
      "value": "personal"
    },
    {
      "kind": "tool_result_field_equals",
      "name": "mcp_eval_mcp_status_51b1cdd4ae261c34",
      "argumentPath": "probe",
      "argumentValue": "second",
      "status": "succeeded",
      "outputPath": "structuredContent.accountId",
      "value": "personal"
    },
    { "kind": "run_status", "status": "succeeded" }
  ]
}
