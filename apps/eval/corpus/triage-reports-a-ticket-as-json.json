{
  "id": "triage-reports-a-ticket-as-json",
  "tier": "l2",
  "agent": "triage",
  "input": [
    {
      "role": "user",
      "content": "Report ticket 4821."
    }
  ],
  "tools": [
    {
      "name": "lookup_ticket",
      "description": "Fetch a ticket by id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string"
          }
        },
        "required": ["ticketId"]
      }
    }
  ],
  "toolResults": [
    {
      "name": "lookup_ticket",
      "output": {
        "ticketId": "4821",
        "status": "closed",
        "owner": "dana"
      }
    }
  ],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [
        {
          "callId": "c1",
          "name": "lookup_ticket",
          "arguments": {
            "ticketId": "4821"
          }
        }
      ]
    },
    {
      "kind": "text",
      "text": "{\"ticketId\": \"4821\", \"status\": \"closed\", \"owner\": \"dana\"}"
    }
  ],
  "expect": [
    {
      "kind": "tool_called",
      "name": "lookup_ticket"
    },
    {
      "kind": "output_field_equals",
      "path": "ticketId",
      "value": "4821"
    },
    {
      "kind": "output_field_equals",
      "path": "status",
      "value": "closed"
    },
    {
      "kind": "output_field_equals",
      "path": "owner",
      "value": "dana"
    },
    {
      "kind": "loop_status",
      "status": "completed"
    }
  ]
}
