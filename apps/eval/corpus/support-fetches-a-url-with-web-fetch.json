{
  "id": "support-fetches-a-url-with-web-fetch",
  "tier": "l2",
  "agent": "support",
  "input": [
    {
      "role": "user",
      "content": "Summarize the release date from https://docs.example.com/releases/2.0"
    }
  ],
  "platformTools": ["web_fetch"],
  "toolResults": [
    {
      "name": "web_fetch",
      "output": {
        "fetched": true,
        "url": "https://docs.example.com/releases/2.0",
        "status": 200,
        "contentType": "text/html",
        "format": "markdown",
        "content": "# Release 2.0\n\nRelease 2.0 launches on September 14.\n\n## Upgrading\n\nRun the migration before you start the new binary.",
        "truncated": false,
        "links": []
      }
    }
  ],
  "script": [
    {
      "kind": "tool_calls",
      "calls": [
        {
          "callId": "c1",
          "name": "web_fetch",
          "arguments": {
            "url": "https://docs.example.com/releases/2.0",
            "prompt": "What is the release date of version 2.0?"
          }
        }
      ]
    },
    {
      "kind": "text",
      "text": "Release 2.0 launches on September 14."
    }
  ],
  "expect": [
    { "kind": "tool_called", "name": "web_fetch" },
    {
      "kind": "tool_argument_equals",
      "name": "web_fetch",
      "path": "url",
      "value": "https://docs.example.com/releases/2.0"
    },
    { "kind": "tool_argument_present", "name": "web_fetch", "path": "prompt" },
    { "kind": "tool_call_count", "count": 1 },
    { "kind": "output_contains", "text": "September 14" },
    { "kind": "loop_status", "status": "completed" }
  ]
}
