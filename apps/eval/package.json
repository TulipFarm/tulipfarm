{
  "name": "@tulipfarm/eval",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "eval": "tsx src/cli.ts",
    "eval:sonnet": "sh scripts/seat.sh sonnet",
    "eval:terra": "sh scripts/seat.sh terra",
    "eval:matrix": "sh scripts/seat.sh sonnet,terra",
    "eval:redteam": "tsx src/cli.ts --corpus corpus/red-team",
    "eval:redteam:matrix": "sh scripts/seat.sh sonnet,terra --corpus corpus/red-team",
    "lint": "biome check --no-errors-on-unmatched .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tulipfarm/agent-runtime": "workspace:*",
    "@tulipfarm/llm": "workspace:*",
    "@tulipfarm/model-adapter": "workspace:*",
    "@tulipfarm/run-kernel": "workspace:*",
    "@tulipfarm/schema": "workspace:*",
    "@tulipfarm/secrets": "workspace:*",
    "@tulipfarm/soul": "workspace:*",
    "@tulipfarm/storage": "workspace:*",
    "@tulipfarm/tool-host": "workspace:*",
    "@tulipfarm/turn-executor": "workspace:*",
    "ai": "^7.0.66"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "@tulipfarm/tsconfig": "workspace:*",
    "@types/node": "^26.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
