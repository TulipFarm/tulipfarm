{
  "name": "@tulipfarm/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local src/worker.ts",
    "dev:storage": "node --env-file-if-exists=.env.storage.local src/storage-worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "node --test test/workspace.integration.mjs",
    "test:telemetry": "node --test test/telemetry.integration.mjs",
    "test:composition": "node --test test/storage-composition.integration.mjs",
    "test:agents": "node --test test/agent-composition.integration.mjs",
    "test:email-delivery": "node --test test/email-delivery.integration.mjs",
    "test:invitation-expiry": "node --test test/invitation-expiry-process.integration.mjs",
    "test:conversations": "node --test test/conversation.integration.mjs",
    "test:atlassian": "node --test test/atlassian-chat.integration.mjs",
    "test:social": "node --test test/social-publisher.integration.mjs",
    "start": "node dist/worker.js",
    "start:storage": "node dist/storage-worker.js"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@tulipfarm/access": "workspace:*",
    "@tulipfarm/agents": "workspace:*",
    "@tulipfarm/atlassian": "workspace:*",
    "@tulipfarm/build-info": "workspace:*",
    "@tulipfarm/config": "workspace:*",
    "@tulipfarm/conversations": "workspace:*",
    "@tulipfarm/email": "workspace:*",
    "@tulipfarm/extensions": "workspace:*",
    "@tulipfarm/files": "workspace:*",
    "@tulipfarm/github": "workspace:*",
    "@tulipfarm/google-workspace": "workspace:*",
    "@tulipfarm/integrations": "workspace:*",
    "@tulipfarm/knowledge": "workspace:*",
    "@tulipfarm/memory-core": "workspace:*",
    "@tulipfarm/observability": "workspace:*",
    "@tulipfarm/recommendations": "workspace:*",
    "@tulipfarm/slack": "workspace:*",
    "@tulipfarm/social": "workspace:*",
    "@tulipfarm/tables": "workspace:*",
    "@tulipfarm/workflow-snippets": "workspace:*",
    "@tulipfarm/workflows": "workspace:*",
    "@tulipfarm/workspace-mcp": "workspace:*",
    "@tulipfarm/workspace-mcp-transport": "workspace:*",
    "@tulipfarm/workspace-storage": "workspace:*",
    "@tulipfarm/workspaces": "workspace:*",
    "pg": "8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@tulipfarm/typescript-config": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "undici": "8.7.0"
  }
}
