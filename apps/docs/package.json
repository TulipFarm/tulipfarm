{
  "name": "@tulipfarm/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/sync-public-assets.mjs && next build",
    "dev": "node scripts/sync-public-assets.mjs && next dev -p 4020",
    "start": "serve out",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check --no-errors-on-unmatched ."
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.14.3",
    "fumadocs-mdx": "15.2.3",
    "fumadocs-ui": "16.14.3",
    "lucide-react": "^1.31.0",
    "next": "16.2.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tulipfarm/tsconfig": "workspace:*",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "postcss": "^8.5.26",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
