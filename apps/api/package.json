{
  "name": "@tulipfarm/api",
  "private": true,
  "type": "module",
  "exports": {
    "./dev-session": "./src/dev-session.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 test/observability.test.mjs test/health-version.test.mjs test/openapi.test.mjs test/business.test.mjs test/model-environment.test.mjs test/model-configuration.test.mjs test/model-catalog.test.mjs test/model-catalog-file.test.mjs test/model-catalog-unmetered.test.mjs test/model-roles-openai-catalog.test.mjs test/agent-authoring-assistance.test.mjs test/turnstile.test.mjs test/dev-sign-in.test.mjs test/dev-session.test.mjs test/viewer.test.mjs test/feature-flags.test.mjs test/security.test.mjs test/public-guide.test.mjs test/conversations.test.mjs test/conversation-events.test.mjs test/conversation-event-routes.test.mjs test/background-sweep.test.mjs test/slack-request.test.mjs test/slack-link-diagnostics.test.mjs test/workspace-mcp-http.test.mjs test/workspace-mcp-contracts.test.mjs test/workspace-mcp-catalog.test.mjs test/atlassian-callback.test.mjs test/recommendations.test.mjs test/integration-status.test.mjs",
    "test:workspace-mcp": "node --test test/workspace-mcp.integration.mjs test/workspace-mcp-oauth.integration.mjs test/workspace-mcp-recovery.integration.mjs",
    "test:security": "node --test test/security.integration.mjs",
    "test:files": "node --test test/files.integration.mjs",
    "test:atlassian": "node --test test/atlassian-callback.test.mjs test/atlassian-accounts.integration.mjs test/atlassian-operations.integration.mjs",
    "test:social": "node --test --test-concurrency=1 test/social-accounts.integration.mjs test/social-posts.integration.mjs",
    "test:integration": "node --test test/health.test.mjs test/auth.test.mjs test/password-auth.test.mjs test/workspaces.integration.mjs",
    "test:governance": "node --test test/governance.integration.mjs test/team-upgrade.integration.mjs",
    "test:google-workspace": "node --test test/google-workspace.integration.mjs",
    "test:model-policy": "node --test test/model-policy.integration.mjs",
    "test:model-runtime": "node --test test/model-runtime.integration.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@tulipfarm/workflow-snippets": "workspace:*",
    "@tulipfarm/build-info": "workspace:*",
    "@tulipfarm/workspace-mcp": "workspace:*",
    "@tulipfarm/workspace-mcp-transport": "workspace:*",
    "@tulipfarm/github": "workspace:*",
    "@tulipfarm/atlassian": "workspace:*",
    "@tulipfarm/workflows": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@temporalio/client": "1.24.0",
    "@tulipfarm/access": "workspace:*",
    "@tulipfarm/agents": "workspace:*",
    "@tulipfarm/config": "workspace:*",
    "@tulipfarm/integrations": "workspace:*",
    "@tulipfarm/conversations": "workspace:*",
    "@tulipfarm/extensions": "workspace:*",
    "@tulipfarm/files": "workspace:*",
    "@tulipfarm/knowledge": "workspace:*",
    "@tulipfarm/google-workspace": "workspace:*",
    "@tulipfarm/observability": "workspace:*",
    "@tulipfarm/recommendations": "workspace:*",
    "@tulipfarm/tables": "workspace:*",
    "@tulipfarm/slack": "workspace:*",
    "@tulipfarm/social": "workspace:*",
    "@tulipfarm/workspace-storage": "workspace:*",
    "@tulipfarm/workspaces": "workspace:*",
    "better-auth": "1.7.6",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tulipfarm/typescript-config": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1"
  }
}
