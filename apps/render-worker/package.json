{
  "name": "@tulipfarm/render-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@tulipfarm/config": "workspace:*",
    "@tulipfarm/plan-documents": "workspace:*",
    "dompurify": "3.4.17",
    "mermaid": "12.2.0",
    "playwright-core": "1.62.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tulipfarm/typescript-config": "workspace:*",
    "@types/node": "26.6.3"
  }
}
