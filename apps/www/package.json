{
  "name": "@tulipfarm/www",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate-deploy-assets.ts && pnpm generate:plan-schema && pnpm generate:pack-schema && node scripts/sync-public-assets.mjs && next dev -p 5100",
    "build": "tsx scripts/generate-deploy-assets.ts && pnpm generate:plan-schema && pnpm generate:pack-schema && node scripts/sync-public-assets.mjs && next build && node scripts/sync-public-assets.mjs --out",
    "generate:plan-schema": "tsx scripts/generate-plan-schema.ts && biome format --write public/schemas/plan/v1.schema.json",
    "generate:pack-schema": "tsx scripts/generate-pack-schema.ts && biome format --write public/schemas/pack/v1.schema.json",
    "start": "serve out -l 5100",
    "preview": "wrangler pages dev out --ip 127.0.0.1 --port 5100 --compatibility-date=2026-09-10",
    "lint": "biome check --no-errors-on-unmatched .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run lib",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tulipfarm/constants": "workspace:*",
    "@tulipfarm/deploy-render": "workspace:*",
    "@tulipfarm/schema": "workspace:*",
    "@tulipfarm/surface": "workspace:*",
    "@tulipfarm/surface-web": "workspace:*",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reicon-react": "1.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tulipfarm/tsconfig": "workspace:*",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.131.0"
  }
}
