{
  "$id": "https://tulipfarm.site/schemas/plan/v1.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": ["apiVersion", "kind", "name", "version", "steps"],
  "properties": {
    "apiVersion": {
      "const": "tulipfarm.ai/v1",
      "type": "string"
    },
    "kind": {
      "const": "Plan",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "maxLength": 128,
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "steps": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "tool"],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "needs": {
                "uniqueItems": true,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                  "type": "string"
                }
              },
              "input": {
                "additionalProperties": false,
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {}
                }
              },
              "tool": {
                "minLength": 1,
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "agent", "prompt"],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "needs": {
                "uniqueItems": true,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                  "type": "string"
                }
              },
              "input": {
                "additionalProperties": false,
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {}
                }
              },
              "agent": {
                "additionalProperties": false,
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              },
              "prompt": {
                "minLength": 1,
                "type": "string"
              },
              "requiredToolCalls": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "output": {
                "type": "object",
                "additionalProperties": true
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "routine"],
            "properties": {
              "id": {
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                "type": "string"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "needs": {
                "uniqueItems": true,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
                  "type": "string"
                }
              },
              "input": {
                "additionalProperties": false,
                "type": "object",
                "patternProperties": {
                  "^(.*)$": {}
                }
              },
              "routine": {
                "additionalProperties": false,
                "type": "object",
                "required": ["name", "version"],
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "version": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TulipFarm YAML Plan v1",
  "description": "A dependency plan containing exact Tool calls, Agent sub-prompts, and child Routines. Use plan_compile to validate dependency cycles, references, and execution semantics.",
  "$comment": "Generated from packages/schema/src/plan.ts. Do not edit this file; run pnpm --filter @tulipfarm/www generate:plan-schema."
}
