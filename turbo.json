{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "docker-compose.yml",
    ".env.example",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/uninstall.sh"
  ],
  "tasks": {
    "@tulipfarm/docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/deploy/contract.yml",
        "$TURBO_ROOT$/deploy/targets/*/manifest.yml",
        "$TURBO_ROOT$/scripts/public-site/**",
        "$TURBO_ROOT$/scripts/generate-tool-docs.ts",
        "$TURBO_ROOT$/packages/tool-host/src/**",
        "$TURBO_ROOT$/packages/constants/src/site.ts",
        "$TURBO_ROOT$/packages/deploy-render/src/**",
        "$TURBO_ROOT$/packages/schema/src/**",
        "$TURBO_ROOT$/packages/tsconfig/*.json"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "@tulipfarm/www#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/deploy/**",
        "$TURBO_ROOT$/scripts/public-site/**",
        "$TURBO_ROOT$/packages/constants/src/site.ts",
        "$TURBO_ROOT$/packages/deploy-render/src/**",
        "$TURBO_ROOT$/packages/schema/src/**",
        "$TURBO_ROOT$/packages/surface/src/**",
        "$TURBO_ROOT$/packages/surface-web/src/**",
        "$TURBO_ROOT$/packages/tsconfig/*.json"
      ],
      "outputs": [".next/**", "!.next/cache/**", "out/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    }
  }
}
