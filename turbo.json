{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "docker-compose.yml",
    ".env.example",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/uninstall.sh"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    }
  }
}
