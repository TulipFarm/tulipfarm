# Generated by `pnpm config:docs` from packages/config/src/settings.ts. Do not edit.
# Copy to self-host/.env, or provide the same names from your secret store.
# Compose reads the shell environment first, then this file. Values containing $
# must be single-quoted here. See https://docs.tulipfarm.ai/self-hosting/secrets/

# Public origin. The web app and the API (/v1) share it.
TULIPFARM_PUBLIC_URL=https://tulipfarm.example.com
# Caddy site address: the domain for automatic HTTPS, or :80 for plain HTTP behind another proxy.
TULIPFARM_SITE_ADDRESS=tulipfarm.example.com

# Build identity: YYYY.M.D.N and the full source commit (git rev-parse HEAD).
TULIPFARM_RELEASE_VERSION=2026.1.1.1
TULIPFARM_RELEASE_COMMIT=

# Infrastructure credentials you choose. Use URL-safe values: openssl rand -hex 32
POSTGRES_PASSWORD=
OBJECT_STORAGE_ACCESS_KEY_ID=tulipfarm
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Models. Set the API key of at least one provider; the shipped model catalog serves every model whose provider key is set.
# Providers, custom catalogs and endpoints: https://docs.tulipfarm.ai/self-hosting/models/
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# Optional gateways, proxies and self-hosted models: replace a provider API base URL. Hosts other than the built-in provider APIs must be listed in MODEL_ENDPOINT_HOSTS.
# ANTHROPIC_BASE_URL=https://gateway.example.com/anthropic
# OPENAI_BASE_URL=https://gateway.example.com/v1
# XAI_BASE_URL=https://gateway.example.com/xai/v1
# GEMINI_BASE_URL=https://gateway.example.com/gemini
# MODEL_ENDPOINT_HOSTS=gateway.example.com
# Your own model catalog, replacing the shipped one. The path is inside the api and worker containers; mount the file with a Compose override.
# MODEL_CATALOG_FILE=/run/tulipfarm-config/model-catalog.json
# MODEL_CATALOG='{"version":1,"models":[...]}'
# Only for Azure Foundry model families.
# AZURE_FOUNDRY_ENDPOINT=
# AZURE_FOUNDRY_API_KEY=

# Optional Cloudflare Turnstile challenge for sign-in. Unset disables it; set both keys for your hostname.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Sign-in. Configure Google, email (SMTP or Azure Communication Services), or both.
# Google redirect URI: ${TULIPFARM_PUBLIC_URL}/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign-in methods to allow. Unset: email links with email, Google with its keys. Password: see README.md#sign-in-methods.
# AUTH_METHODS=password,magic-link,google
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=
# Email through any SMTP server instead of ACS. See https://docs.tulipfarm.ai/self-hosting/email/#choose-a-transport
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=noreply@example.com

# Semantic knowledge search. Disabled unless set. The provider must serve
# text-embedding-3-large at 1536 dimensions. See https://docs.tulipfarm.ai/self-hosting/models/#embedding-providers
# KNOWLEDGE_EMBEDDINGS_ENABLED=true
# KNOWLEDGE_EMBEDDINGS_PROVIDER=openai-compatible
# KNOWLEDGE_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# KNOWLEDGE_EMBEDDINGS_API_KEY=
# KNOWLEDGE_EMBEDDINGS_MODEL=text-embedding-3-large
# KNOWLEDGE_EMBEDDINGS_DIMENSIONS=1536

# Temporal. COMPOSE_PROFILES=temporal runs Temporal (server, UI, schema and namespace jobs) in this stack.
# For your own Temporal: remove temporal from COMPOSE_PROFILES, set TEMPORAL_ADDRESS and
# TEMPORAL_NAMESPACE, and set TEMPORAL_UI_URL to your UI or to empty to skip its health probe.
# For Temporal Cloud, also set TEMPORAL_TLS=true and TEMPORAL_API_KEY (or TEMPORAL_API_KEY_FILE).
COMPOSE_PROFILES=temporal
# TEMPORAL_UI_PORT=8233
# TEMPORAL_HISTORY_SHARDS=128
# TEMPORAL_UI_URL=
# TEMPORAL_ADDRESS=temporal.example.com:7233
# TEMPORAL_TLS=true
# TEMPORAL_API_KEY=
# TEMPORAL_NAMESPACE=default

# Public web search and page reads for agents. Off unless set. Use a Firecrawl-compatible API
# (POST /v2/search, POST /v2/scrape). Set FIRECRAWL_API_KEY for authenticated APIs such as Firecrawl Cloud.
# Health uses GET /v2/team/credit-usage with a key, otherwise GET /health; neither spends scrape credits.
# The service must not be able to reach your internal network.
# FIRECRAWL_ENDPOINT=http://firecrawl.internal:3002
# FIRECRAWL_API_KEY=

# OpenTelemetry export to your own backend over OTLP/HTTP. Off unless CLOUD_TELEMETRY_ENABLED=true.
# Only allowlisted attributes leave the process. See README.md#telemetry.
# CLOUD_TELEMETRY_ENABLED=true
# CLOUD_TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4318
# CLOUD_TELEMETRY_OTLP_TRACES_ENDPOINT=
# CLOUD_TELEMETRY_OTLP_METRICS_ENDPOINT=
# CLOUD_TELEMETRY_OTLP_LOGS_ENDPOINT=
# CLOUD_TELEMETRY_OTLP_AUTHORIZATION=
# CLOUD_TELEMETRY_OTLP_HEADERS=
# CLOUD_TELEMETRY_OTLP_ALLOW_HTTP=
# CLOUD_TELEMETRY_TRACES_ENABLED=
# CLOUD_TELEMETRY_METRICS_ENABLED=
# CLOUD_TELEMETRY_LOGS_ENABLED=
# CLOUD_TELEMETRY_SAMPLE_RATIO=
# CLOUD_TELEMETRY_JOB_SAMPLE_RATIO=
# CLOUD_TELEMETRY_ENVIRONMENT=

# Feature flags. true or false overrides a flag default when no flag provider extension answers.
# Without an override, flags are off in production.
# FEATURE_FLAG_SOUL_REPOSITORY_EXPLORER=true
# FEATURE_FLAG_PUBLIC_TULIPFARM_GUIDE=true
# FEATURE_FLAG_GOOGLE_CALENDAR_CANVAS=true
# FEATURE_FLAG_IMAGES=true
# FEATURE_FLAG_SLACK_APP_SENDER=true
# FEATURE_FLAG_DEFAULT_CONNECTION_KNOWLEDGE=true
# FEATURE_FLAG_BUD_AVATAR=true
# FEATURE_FLAG_SOCIAL_PUBLISHING=true

# Optional.
# TULIPFARM_HTTP_PORT=80
# TULIPFARM_HTTPS_PORT=443
# TULIPFARM_SUPPORT_EMAIL=support@example.com
