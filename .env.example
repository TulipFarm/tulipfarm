# TulipFarm — production environment (OCI / docker-compose lane)
# The installer (scripts/install.sh) generates the random secrets and PUBLIC_URL
# for you. This file documents every variable the `app` reads.
#
# NOTHING HERE IS REQUIRED. `docker compose up -d` with no `.env` at all works:
# every variable has a default and the three bootstrap secrets are generated on
# first boot onto the `tulipfarm-data` volume (INST-002). This file is for the
# installer and for anyone who wants to manage those values themselves.

# --- Public URL (drives CORS + cookie Secure flag, INST-003c) ---
# Installer smart-detects: loopback -> http://localhost:8080 ;
# public IP -> http://<ip>:8080. Set to an https:// URL once behind TLS — that is
# what marks session cookies `Secure`.
PUBLIC_URL=http://localhost:8080
# Only needed when the SPA is served from a different origin than the API.
# CORS_ORIGIN=

# --- TLS (optional reverse proxy) ---
# Bind the app to loopback when the proxy runs on the same host.
# HOST_BIND=127.0.0.1

# --- Datastore (PostgreSQL 17 + pgvector) ---
# Bundled mode (default): the `postgres` service starts and the compose file wires
# DATABASE_URL to it from POSTGRES_PASSWORD below.
# External/managed mode: set EXTERNAL_DATASTORE=true, point DATABASE_URL at your
# managed Postgres (must allow the `vector` + `citext` extensions — the app creates
# them at boot), and start only the app: `docker compose up -d app`.
EXTERNAL_DATASTORE=false
DATABASE_URL=postgresql://tulipfarm:CHANGE_ME_POSTGRES@postgres:5432/tulipfarm

# Bundled datastore credential (installer-generated). Compose defaults this to
# `tulipfarm` so the file runs with no setup; port 5432 is never published.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# --- Bootstrap secrets (installer-generated: openssl rand -base64 32) ---
# Leave these unset to have the app generate and persist them to TF_DATA_DIR
# (/data) on first boot. Set them to manage the keys yourself — env always wins.
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64
# Set only during key rotation (SEC-V1-001 dual-key graceful decrypt):
# ENCRYPTION_KEY_PREVIOUS=
JWT_SECRET=CHANGE_ME_BASE64
WEBHOOK_SIGNING_SECRET=CHANGE_ME_BASE64

# --- Soul ---
SOUL_PATH=/opt/tulipfarm/soul
# Where generated bootstrap secrets (and, later, backups) are persisted. Must be a
# mounted volume — the app refuses to boot rather than generate keys it would lose.
TF_DATA_DIR=/data
# Optional git remote for soul backup/sync. Activate by setting both; restart to apply.
# SOUL_GIT_REMOTE_URL=
# SOUL_GIT_CREDENTIAL=

# --- Headless seeding (container platforms: Cloud Run, Fly, App Service) ---
# Set ALL THREE to skip the web setup wizard and seed on first boot automatically.
# The app detects these at startup: if ADMIN_EMAIL + ADMIN_PASSWORD + LLM_API_KEY are
# all present it seeds and marks setup complete; the web wizard never appears.
# Partial (admin creds without LLM_API_KEY) → refused at startup with a clear error.
# Leave all three unset to use the interactive web setup wizard (curl|bash installs).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# BUSINESS_NAME=
# BUSINESS_DESCRIPTION=

# --- Durable worker (the `worker` compose service) ---
# Runs off the same image as `app` and shares DATABASE_URL. It never migrates: it refuses to
# start below the schema version `app` has applied, which is why it waits for `app` to be
# healthy. Every value below has a default — set them only to tune the loops.
# It executes the turn, so it also needs a credential for the API's internal turn host. `app`
# mints one on first boot and writes it to /data/worker.env, which the worker reads back; set
# WORKER_API_CREDENTIAL here (a `tfc_<clientId>.<secret>` from Settings → API clients) only to
# manage that identity yourself.
# WORKER_API_CREDENTIAL=
# WORKER_PORT=4020              # /livez + /readyz, unpublished (probes are for the orchestrator)
# WORKER_OWNER=<hostname>:<pid> # lease owner; must be unique per process
# WORKER_RUN_POLL_MS=1000
# WORKER_WAIT_SWEEP_MS=5000
# WORKER_OUTBOX_POLL_MS=1000
# WORKER_BATCH_SIZE=25
# WORKER_LEASE_MS=60000         # must exceed WORKER_RUN_POLL_MS
# WORKER_DRAIN_TIMEOUT_MS=15000 # SIGTERM budget; a timed-out drain exits non-zero

# --- Misc ---
PORT=8080
NODE_ENV=production
SESSION_TTL_SECONDS=604800
