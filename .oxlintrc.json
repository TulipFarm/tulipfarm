{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "jsPlugins": ["@shadcn/lint", "./tooling/design-system-lint.mjs"],
  "categories": {
    "correctness": "error"
  },
  "overrides": [
    {
      "files": ["packages/memory-core/**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}"],
      "rules": {
        "tulipfarm/memory-core-boundary": "error"
      }
    },
    {
      "files": ["apps/**/*.{js,jsx,ts,tsx,mjs}", "packages/**/*.{js,jsx,ts,tsx,mjs}"],
      "rules": {
        "tulipfarm/product-copy": "error"
      }
    },
    {
      "files": ["apps/**/*.{jsx,tsx}", "packages/**/*.{jsx,tsx}"],
      "rules": {
        "shadcn/no-restyle": [
          "error",
          {
            "allow": [],
            "deny": ["*"]
          }
        ],
        "shadcn/no-inline-styles": "error",
        "shadcn/no-raw-colors": "error",
        "shadcn/no-arbitrary-values": "error",
        "shadcn/require-static-classes": "error",
        "tulipfarm/shared-controls": "error",
        "tulipfarm/no-component-overrides": "error",
        "tulipfarm/custom-select": "error"
      }
    },
    {
      "files": [
        "apps/**/components/ui/**",
        "packages/**/components/ui/**",
        "apps/web/src/components/{action-button,bubble,bud-launcher,calendar-board,calendar-event-list,chat-suggestions,data-grid,data-list,divider,drawer,empty,item,marker,reasoning,sidebar,table-pagination,thinking-state,tool-call,tulip-avatar,turnstile-challenge,workflow-diagram,worksheet-grid}.tsx",
        "apps/web/src/components/tulip-avatar/**"
      ],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-inline-styles": "off",
        "shadcn/no-raw-colors": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off",
        "tulipfarm/shared-controls": "off",
        "tulipfarm/no-component-overrides": "off",
        "tulipfarm/custom-select": "off"
      }
    },
    {
      "files": [
        "apps/web/src/features/atlassian/accounts.tsx",
        "apps/web/src/features/atlassian/operations.tsx",
        "apps/web/src/features/atlassian/sources.tsx",
        "apps/web/src/features/integrations/atlassian-knowledge-selection.tsx",
        "apps/web/src/features/integrations/editor.tsx",
        "apps/web/src/features/integrations/github-knowledge-selection.tsx",
        "apps/web/src/features/integrations/google-knowledge-selection.tsx",
        "apps/web/src/features/integrations/setup.tsx",
        "apps/web/src/features/integrations/slack-knowledge-selection.tsx",
        "apps/web/src/features/files/filters.tsx",
        "apps/web/src/features/files/google-copy.tsx",
        "apps/web/src/features/files/sharing.tsx",
        "apps/web/src/features/projects/project-scope.tsx",
        "apps/web/src/features/tables/field-input.tsx",
        "apps/web/src/features/tables/person-grants.tsx",
        "apps/web/src/features/tables/table-picker.tsx",
        "apps/web/src/features/tables/tables.tsx",
        "apps/web/src/features/workflows/editor-controls.tsx",
        "apps/web/src/features/workflows/table-step-controls.tsx",
        "apps/web/src/pages/files.tsx",
        "apps/web/src/pages/governance.tsx",
        "apps/web/src/pages/projects.tsx",
        "apps/web/src/pages/team-administration.tsx",
        "apps/web/src/pages/workflows.tsx"
      ],
      "rules": {
        "tulipfarm/custom-select": "off"
      }
    }
  ],
  "ignorePatterns": ["**/node_modules/**", "**/.turbo/**", "**/dist/**", "**/coverage/**"]
}
