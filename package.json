{
  "name": "tulipfarm",
  "private": true,
  "version": "0.13.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TulipFarm/tulipfarm.git"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": "26.5.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@tulipfarm/api --filter=@tulipfarm/web --filter=@tulipfarm/worker --filter=@tulipfarm/integration-worker",
    "dev:api": "turbo dev --filter=@tulipfarm/api",
    "dev:docs": "turbo dev --filter=@tulipfarm/docs",
    "dev:web": "turbo dev --filter=@tulipfarm/web",
    "dev:worker": "turbo dev --filter=@tulipfarm/worker",
    "dev:integration-worker": "turbo dev --filter=@tulipfarm/integration-worker",
    "reset:dev": "bash scripts/reset-dev.sh",
    "eval": "pnpm --filter @tulipfarm/eval eval",
    "eval:sonnet": "pnpm --filter @tulipfarm/eval eval:sonnet",
    "eval:terra": "pnpm --filter @tulipfarm/eval eval:terra",
    "eval:matrix": "pnpm --filter @tulipfarm/eval eval:matrix",
    "eval:redteam": "pnpm --filter @tulipfarm/eval eval:redteam",
    "eval:redteam:matrix": "pnpm --filter @tulipfarm/eval eval:redteam:matrix",
    "architecture:check": "node scripts/architecture-check.ts",
    "reachability:check": "node scripts/reachability-check.ts",
    "check:secure-context": "bash scripts/test/check-secure-context-apis.sh && vitest run scripts/test/check-secure-context-apis.test.ts",
    "architecture:test": "vitest run scripts/*.test.ts scripts/lib test/security",
    "docs:test": "vitest run scripts/site-url.test.ts scripts/docs-fitness.test.ts scripts/docs-control-evidence.test.ts",
    "test:e2e:browser": "node scripts/test/browser-smoke.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p scripts/test/tsconfig.json",
    "test": "turbo test",
    "release": "node scripts/request-release.ts",
    "release:canary": "node scripts/request-release.ts",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "@typescript/typescript6": "^6.0.2",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "semver": "^7.7.4",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "dompurify": "^3.4.12",
    "undici": "^7.28.0",
    "body-parser": "^1.20.6"
  }
}
