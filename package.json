{
  "name": "tulipfarm",
  "private": true,
  "version": "0.8.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/TulipFarm/tulipfarm.git"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": "26.5.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@tulipfarm/api --filter=@tulipfarm/web --filter=@tulipfarm/worker --filter=@tulipfarm/integration-worker",
    "dev:api": "turbo dev --filter=@tulipfarm/api",
    "dev:docs": "turbo dev --filter=@tulipfarm/docs",
    "dev:web": "turbo dev --filter=@tulipfarm/web",
    "dev:worker": "turbo dev --filter=@tulipfarm/worker",
    "dev:integration-worker": "turbo dev --filter=@tulipfarm/integration-worker",
    "reset:dev": "bash scripts/reset-dev.sh",
    "architecture:check": "node scripts/architecture-check.ts",
    "check:secure-context": "bash scripts/test/check-secure-context-apis.sh && vitest run scripts/test/check-secure-context-apis.test.ts",
    "architecture:test": "vitest run scripts/*.test.ts scripts/lib",
    "test:e2e:browser": "node scripts/test/browser-smoke.mjs",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p scripts/test/tsconfig.json",
    "test": "turbo test",
    "release": "node scripts/request-release.ts",
    "release:canary": "node scripts/request-release.ts",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/semver": "^7.7.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.8",
    "playwright": "^1.62.1",
    "semver": "^7.7.4",
    "turbo": "^2.10.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "resolutions": {
    "dompurify": "^3.4.12",
    "undici": "^7.28.0",
    "body-parser": "^1.20.6"
  }
}
