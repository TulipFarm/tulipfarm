{
  "name": "tulipfarm",
  "private": true,
  "version": "0.4.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/TulipFarm/tulipfarm.git"
  },
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": "26.5.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@tulipfarm/api --filter=@tulipfarm/web --filter=@tulipfarm/worker",
    "dev:api": "turbo dev --filter=@tulipfarm/api",
    "dev:docs": "turbo dev --filter=@tulipfarm/docs",
    "dev:web": "turbo dev --filter=@tulipfarm/web",
    "dev:worker": "turbo dev --filter=@tulipfarm/worker",
    "reset:dev": "bash scripts/reset-dev.sh",
    "architecture:check": "node scripts/architecture-check.ts",
    "architecture:test": "vitest run scripts",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "release": "node scripts/request-release.ts",
    "release:canary": "node scripts/request-release.ts",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/semver": "^7.7.1",
    "conventional-changelog": "^7.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.2.0",
    "semver": "^7.7.4",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
