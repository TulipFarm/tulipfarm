{
  "name": "tulipfarm",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@tulipfarm/api --filter=@tulipfarm/web",
    "dev:api": "turbo dev --filter=@tulipfarm/api",
    "dev:docs": "turbo dev --filter=@tulipfarm/docs",
    "dev:web": "turbo dev --filter=@tulipfarm/web",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "lefthook": "^1",
    "lint-staged": "^15",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "vitest": "^4"
  }
}
